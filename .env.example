# Copy to .env and load with: node --env-file=.env server/index.mjs
HOST=127.0.0.1
PORT=4310
PUBLIC_URL=http://localhost:4310
DATA_DIR=./data
# Default AI provider: Meta Model API (OpenAI-compatible). Key from dev.meta.ai.
AI_BASE_URL=https://api.meta.ai/v1
AI_MODEL=muse-spark-1.1
AI_API_KEY=
# OAuth callback: PUBLIC_URL/api/oauth/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
# Explicit outbound destinations, comma separated; HTTPS required.
WEBHOOK_ALLOWED_HOSTS=
# Voice transcription needs an endpoint with /audio/transcriptions (optional).
AI_AUDIO_BASE_URL=
AI_AUDIO_API_KEY=
AI_AUDIO_MODEL=
# Set when running behind a reverse proxy (Vercel rewrite / Cloudflare Tunnel).
TRUST_PROXY=
